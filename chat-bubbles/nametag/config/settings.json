{
	"message-category": {
		"label": "Message",
		"settings": {
			"font-section": {
				"type": "section",
				"label": "Text",
				"settings": {
					"font-name": {
						"type": "font-input",
						"label": "Font",
						"halfSpan": true
					},
					"font-weight": {
						"type": "dropdown-input",
						"label": "Font Weight",
						"condition": {},
						"halfSpan": true,
						"defaultValue": 400,
						"options": [
							{
								"label": "Thin",
								"value": 100
							},
							{
								"label": "Extra-Light",
								"value": 200
							},
							{
								"label": "Light",
								"value": 300
							},
							{
								"label": "Normal",
								"value": 400
							},
							{
								"label": "Medium",
								"value": 500
							},
							{
								"label": "Semi-Bold",
								"value": 600
							},
							{
								"label": "Bold",
								"value": 700
							},
							{
								"label": "Extra-Bold",
								"value": 800
							},
							{
								"label": "Heavy",
								"value": 900
							}
						]
					},
					"font-size": {
						"type": "slider-input",
						"label": "Font Size (px)",
						"defaultValue": 14,
						"min": 1,
						"max": 72,
						"step": 1
					},
					"customize-user-font": {
						"type": "toggle-input",
						"label": "Customize Username Font Separately?",
						"defaultValue": false
					},
					"custom-username-font-name": {
						"type": "font-input",
						"label": "Username Font",
						"condition": {
							"customize-user": [true]
						},
						"halfSpan": true
					},
					"custom-username-font-weight": {
						"type": "dropdown-input",
						"label": "Username Font Weight",
						"condition": {
							"customize-user": [true]
						},
						"halfSpan": true,
						"defaultValue": 700,
						"options": [
							{
								"label": "Thin",
								"value": 100
							},
							{
								"label": "Extra-Light",
								"value": 200
							},
							{
								"label": "Light",
								"value": 300
							},
							{
								"label": "Normal",
								"value": 400
							},
							{
								"label": "Medium",
								"value": 500
							},
							{
								"label": "Semi-Bold",
								"value": 600
							},
							{
								"label": "Bold",
								"value": 700
							},
							{
								"label": "Extra-Bold",
								"value": 800
							},
							{
								"label": "Heavy",
								"value": 900
							}
						]
					},
					"custom-username-font-size": {
						"type": "slider-input",
						"label": "Username Font Size (px)",
						"condition": {
							"customize-user": [true]
						},
						"defaultValue": 14,
						"min": 1,
						"max": 72,
						"step": 1
					},
					"max-lines": {
						"type": "slider-input",
						"label": "Max Lines",
						"halfSpan": true,
						"defaultValue": 4,
						"min": 1,
						"max": 10,
						"step": 1
					},
					"max-width": {
						"type": "number-input",
						"label": "Max Message Width (px)",
						"halfSpan": true,
						"defaultValue": 500,
						"min": 0,
						"max": 10000,
						"step": 1
					},
					"full-width": {
						"type": "toggle-input",
						"label": "Full Width Messages?",
						"defaultValue": false,
						"description": "Sets message width to always be at max width."
					}
				}
			},
			"colors-section": {
				"type": "section",
				"label": "Colors",
				"settings": {
					"message-color": {
						"type": "color-input",
						"label": "Message Text Color",
						"halfSpan": true,
						"defaultValue": "#000"
					},
					"message-bg-color": {
						"type": "color-input",
						"label": "Message Background Color",
						"halfSpan": true,
						"defaultValue": "#fff"
					},
					"rainbow-types": {
						"type": "multi-select-input",
						"label": "Animated Rainbow Background",
						"defaultValue": [
							"highlighted",
							"announcement",
							"cheer",
							"power-up"
						],
						"description": "The selected message types will have an animated rainbow background.",
						"options": [
							{
								"label": "Highlighted",
								"value": "highlighted"
							},
							{
								"label": "Announcement",
								"value": "announcement"
							},
							{
								"label": "Cheer",
								"value": "cheer"
							},
							{
								"label": "Power-Up Effect",
								"value": "power-up"
							}
						]
					},
					"use-custom-user": {
						"type": "toggle-input",
						"label": "Use Custom User Colors?",
						"defaultValue": false
					},
					"user-color": {
						"type": "color-input",
						"label": "User Text Color",
						"condition": {
							"use-custom-user": true
						},
						"halfSpan": true,
						"defaultValue": "#fff"
					},
					"user-bg-color": {
						"type": "color-input",
						"label": "User Background Color",
						"condition": {
							"use-custom-user": true
						},
						"halfSpan": true,
						"defaultValue": "#000"
					}
				}
			},
			"corner-section": {
				"type": "section",
				"label": "Corner",
				"settings": {
					"corner-type": {
						"type": "select-input",
						"label": "Corner Type",
						"defaultValue": "rounded",
						"options": [
							{
								"label": "Rounded",
								"value": "rounded"
							},
							{
								"label": "Square",
								"value": "square"
							},
							{
								"label": "Diagonal",
								"value": "diagonal"
							}
						]
					}
				}
			},
			"badges-section": {
				"type": "section",
				"label": "Badges",
				"settings": {
					"hide-badges": {
						"type": "toggle-input",
						"label": "Hide Badges?",
						"defaultValue": false
					},
					"badge-size": {
						"type": "slider-input",
						"label": "Badge Size Multiplier",
						"condition": {
							"hide-badges": [false]
						},
						"defaultValue": 1.25,
						"min": 1,
						"max": 4,
						"step": 0.05,
						"description": "Multiplier dependent on the username font size."
					}
				}
			},
			"pronouns-section": {
				"type": "section",
				"label": "Pronouns",
				"settings": {
					"pronouns-text": {
						"type": "text-display",
						"label": "User pronouns are sourced from https://pr.alejo.io/ and https://pronoundb.org/"
					},
					"pronouns-display": {
						"type": "select-input",
						"label": "Pronouns Display",
						"defaultValue": "lowercase",
						"options": [
							{
								"label": "Lowercase",
								"value": "lowercase"
							},
							{
								"label": "Capitalized",
								"value": "capitalize"
							},
							{
								"label": "Uppercase",
								"value": "uppercase"
							},
							{
								"label": "Hidden",
								"value": "hidden"
							}
						]
					}
				}
			},
			"plurality-section": {
				"type": "section",
				"label": "Plurality",
				"settings": {
					"plurality-text": {
						"type": "text-display",
						"label": "User system and member information is sourced from https://pluralmind.chat/\nNot sure what plurality is? Consider checking out https://morethanone.info/"
					},
					"plurality-support": {
						"type": "toggle-input",
						"label": "Plurality Support?",
						"halfSpan": true,
						"defaultValue": true,
						"description": "Uses a member's name, pronouns and color when a proxied message is detected."
					},
					"plurality-show-usernames": {
						"type": "toggle-input",
						"label": "Keep Original Usernames?",
						"halfSpan": true,
						"defaultValue": false,
						"description": "Shows the user's Twitch username in parentheses after their member name."
					}
				}
			},
			"localized-section": {
				"type": "section",
				"label": "Localized Names",
				"settings": {
					"localized-show-usernames": {
						"type": "toggle-input",
						"label": "Show original usernames for users with localized display names?",
						"defaultValue": false,
						"description": "Shows the user's Twitch username in parenthesis after their localized display name.\nLocalized Display Names: https://blog.twitch.tv/en/2016/08/22/localized-display-names-e00ee8d3250a/"
					}
				}
			},
			"emotes-section": {
				"type": "section",
				"label": "Emotes",
				"settings": {
					"use-static-emotes": {
						"type": "toggle-input",
						"label": "Static Emotes",
						"halfSpan": true,
						"defaultValue": false,
						"description": "If enabled, emotes won't be animated."
					},
					"use-dynamic-emote-sizing": {
						"type": "toggle-input",
						"label": "Dynamic Emote Sizing?",
						"halfSpan": true,
						"defaultValue": true,
						"description": "When enabled, emotes are larger when the message only contains emotes or is using Gigantify an Emote."
					},
					"multi-emote-size": {
						"type": "slider-input",
						"label": "Multiple Emotes Size Multiplier",
						"condition": {
							"use-dynamic-emote-sizing": [true]
						},
						"halfSpan": true,
						"defaultValue": 1.5,
						"min": 1,
						"max": 4,
						"step": 0.05,
						"description": "When a message only contains multiple emotes."
					},
					"single-emote-size": {
						"type": "slider-input",
						"label": "Single Emote Size Multiplier",
						"condition": {
							"use-dynamic-emote-sizing": [true]
						},
						"halfSpan": true,
						"defaultValue": 2,
						"min": 1,
						"max": 4,
						"step": 0.05,
						"description": "When a message contains only one emote, or is using Gigantify an Emote."
					}
				}
			}
		}
	},
	"position-category": {
		"label": "Position",
		"settings": {
			"arrangement": {
				"type": "select-input",
				"label": "Message Arrangement",
				"defaultValue": "vertical",
				"options": [
					{
						"label": "Vertical",
						"value": "vertical"
					},
					{
						"label": "Horizontal",
						"value": "horizontal"
					},
					{
						"label": "Random",
						"value": "random"
					},
					{
						"label": "Random Edge",
						"value": "random-edge"
					}
				]
			},
			"edges": {
				"type": "multi-select-input",
				"label": "Random Edges",
				"condition": {
					"arrangement": "random-edge"
				},
				"halfSpan": true,
				"defaultValue": ["bottom"],
				"options": [
					{
						"label": "Left",
						"value": "left"
					},
					{
						"label": "Right",
						"value": "right"
					},
					{
						"label": "Top",
						"value": "top"
					},
					{
						"label": "Bottom",
						"value": "bottom"
					}
				]
			},
			"edge-offset": {
				"type": "slider-input",
				"label": "Max Offset from Edge (px)",
				"condition": {
					"arrangement": "random-edge"
				},
				"halfSpan": true,
				"defaultValue": 100,
				"min": 0,
				"max": 1000,
				"step": 1,
				"description": "Max distance that the messages can be from the edge."
			},
			"vertical-flow": {
				"type": "select-input",
				"label": "Vertical Flow",
				"condition": {
					"arrangement": "vertical"
				},
				"halfSpan": true,
				"defaultValue": "to-top",
				"options": [
					{
						"label": "Bottom to Top",
						"value": "to-top"
					},
					{
						"label": "Top to Bottom",
						"value": "to-bottom"
					}
				]
			},
			"vertical-align": {
				"type": "select-input",
				"label": "Vertical Alignment",
				"condition": {
					"arrangement": "vertical"
				},
				"halfSpan": true,
				"defaultValue": "left",
				"options": [
					{
						"label": "Left",
						"value": "left"
					},
					{
						"label": "Right",
						"value": "right"
					}
				]
			},
			"horizontal-flow": {
				"type": "select-input",
				"label": "Horizontal Flow",
				"condition": {
					"arrangement": "horizontal"
				},
				"halfSpan": true,
				"defaultValue": "to-left",
				"options": [
					{
						"label": "Right to Left",
						"value": "to-left"
					},
					{
						"label": "Left to Right",
						"value": "to-right"
					}
				]
			},
			"horizontal-align": {
				"type": "select-input",
				"label": "Horizontal Alignment",
				"condition": {
					"arrangement": "horizontal"
				},
				"halfSpan": true,
				"defaultValue": "top",
				"options": [
					{
						"label": "Top",
						"value": "top"
					},
					{
						"label": "Bottom",
						"value": "bottom"
					}
				]
			}
		}
	},
	"animation-category": {
		"label": "Animation",
		"settings": {
			"smooth-entrance": {
				"type": "toggle-input",
				"label": "Use Smooth Scroll",
				"defaultValue": true,
				"description": "Message size is animated with the entrance animation."
			},
			"entrance-animation": {
				"type": "dropdown-input",
				"label": "Entrance Animation",
				"halfSpan": true,
				"defaultValue": "fade-in",
				"options": [
					{
						"label": "None",
						"value": "none"
					},
					{
						"label": "Expand In",
						"value": "expand-in"
					},
					{
						"label": "Fade In",
						"value": "fade-in"
					},
					{
						"label": "Fade In Left",
						"value": "fade-in-left"
					},
					{
						"label": "Fade In Right",
						"value": "fade-in-right"
					},
					{
						"label": "Fade In Up",
						"value": "fade-in-up"
					},
					{
						"label": "Fade In Down",
						"value": "fade-in-down"
					},
					{
						"label": "Slide In Left",
						"value": "slide-in-left"
					},
					{
						"label": "Slide In Right",
						"value": "slide-in-right"
					},
					{
						"label": "Slide In Up",
						"value": "slide-in-up"
					},
					{
						"label": "Slide In Down",
						"value": "slide-in-down"
					},
					{
						"label": "Zoom In",
						"value": "zoom-in"
					},
					{
						"label": "Zoom In Left",
						"value": "zoom-in-left"
					},
					{
						"label": "Zoom In Right",
						"value": "zoom-in-right"
					},
					{
						"label": "Zoom In Up",
						"value": "zoom-in-up"
					},
					{
						"label": "Zoom In Down",
						"value": "zoom-in-down"
					}
				]
			},
			"exit-animation": {
				"type": "dropdown-input",
				"label": "Exit Animation",
				"halfSpan": true,
				"defaultValue": "fade-out",
				"options": [
					{
						"label": "None",
						"value": "none"
					},
					{
						"label": "Fade Out",
						"value": "fade-out"
					},
					{
						"label": "Fade Out Left",
						"value": "fade-out-left"
					},
					{
						"label": "Fade Out Right",
						"value": "fade-out-right"
					},
					{
						"label": "Fade Out Up",
						"value": "fade-out-up"
					},
					{
						"label": "Fade Out Down",
						"value": "fade-out-down"
					},
					{
						"label": "Slide Out Left",
						"value": "slide-out-left"
					},
					{
						"label": "Slide Out Right",
						"value": "slide-out-right"
					},
					{
						"label": "Slide Out Up",
						"value": "slide-out-up"
					},
					{
						"label": "Slide Out Down",
						"value": "slide-out-down"
					},
					{
						"label": "Zoom Out",
						"value": "zoom-out"
					},
					{
						"label": "Zoom Out Left",
						"value": "zoom-out-left"
					},
					{
						"label": "Zoom Out Right",
						"value": "zoom-out-right"
					},
					{
						"label": "Zoom Out Up",
						"value": "zoom-out-up"
					},
					{
						"label": "Zoom Out Down",
						"value": "zoom-out-down"
					}
				]
			}
		}
	},
	"lifetime-category": {
		"label": "Lifetime",
		"settings": {
			"delay": {
				"type": "slider-input",
				"label": "Message Delay (seconds)",
				"halfSpan": true,
				"defaultValue": 0,
				"min": 0,
				"max": 30,
				"step": 1
			},
			"max-messages": {
				"type": "slider-input",
				"label": "Max Messages",
				"halfSpan": true,
				"defaultValue": 25,
				"min": 1,
				"max": 200,
				"step": 1
			},
			"hide-clipping": {
				"type": "toggle-input",
				"label": "Hide messages that clip out of bounds?",
				"defaultValue": true
			},
			"expire-messages": {
				"type": "toggle-input",
				"label": "Hide messages after some time?",
				"halfSpan": true,
				"defaultValue": false
			},
			"hide-time": {
				"type": "number-input",
				"label": "Hide Time (seconds)",
				"condition": {
					"expire-messages": true
				},
				"halfSpan": true,
				"defaultValue": 300,
				"min": 1,
				"step": 1
			}
		}
	},
	"filters-category": {
		"label": "Filters",
		"settings": {
			"user-filters": {
				"type": "section",
				"label": "User Filters",
				"settings": {
					"user-filter-type": {
						"type": "select-input",
						"label": "Filter Type",
						"defaultValue": "deny",
						"options": [
							{
								"label": "Deny",
								"value": "deny"
							},
							{
								"label": "Allow",
								"value": "allow"
							}
						]
					},
					"allow-users": {
						"type": "multi-text-input",
						"description": "Only show messages from these users, and no one else",
						"condition": {
							"user-filter-type": ["allow"]
						},
						"label": "Allow Users",
						"placeholder": "Name"
					},
					"hide-users": {
						"type": "multi-text-input",
						"label": "Hide Users",
						"condition": {
							"user-filter-type": ["deny"]
						},
						"defaultValue": ["Sery_Bot"],
						"placeholder": "Name"
					},
					"follower-only": {
						"type": "toggle-input",
						"label": "Follower Only Mode",
						"condition": {
							"user-filter-type": ["deny"]
						},
						"defaultValue": false,
						"halfSpan": true
					},
					"follow-age": {
						"type": "number-input",
						"label": "Minimum follow age (hours)",
						"condition": {
							"follower-only": true
						},
						"defaultValue": 0,
						"min": 0,
						"step": "any",
						"description": "Will only show messages from followers that have followed for at least this many hours.",
						"halfSpan": true
					}
				}
			},
			"message-filters": {
				"type": "section",
				"label": "Message Filters",
				"settings": {
					"hide-prefixes": {
						"type": "multi-text-input",
						"label": "Hide messages starting with",
						"defaultValue": ["!"],
						"placeholder": "Prefix",
						"halfSpan": true
					},
					"hide-words": {
						"type": "multi-text-input",
						"label": "Hide messages containing these words",
						"placeholder": "Bad Word",
						"halfSpan": true
					},
					"hide-first-chat": {
						"type": "toggle-input",
						"label": "Hide First Time Chat Messages?",
						"defaultValue": false
					}
				}
			}
		}
	},
	"sound-category": {
		"label": "Sound Effect",
		"settings": {
			"sound": {
				"type": "audio-input",
				"label": "Sound",
				"description": "Play this sound effect for every chat message.",
				"halfSpan": true
			},
			"sound-cooldown": {
				"type": "slider-input",
				"label": "Cooldown (seconds)",
				"defaultValue": 5,
				"min": 0,
				"max": 600,
				"step": 1,
				"description": "Minimum time between playing sounds.",
				"halfSpan": true
			}
		}
	}
}
