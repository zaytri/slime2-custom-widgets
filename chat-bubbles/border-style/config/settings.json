					},
					{
						"label": "Zoom In Right",
						"value": "zoom-in-right"
					},
					{
						"label": "Zoom In Up",
						"value": "zoom-in-up"
					},
					{
						"label": "Zoom In Down",
						"value": "zoom-in-down"
					}
				]
