	"lifetime-category": {
		"label": "Lifetime",
		"settings": {
			"delay": {
				"label": "Message Delay (seconds)",
				"type": "slider-input",
				"defaultValue": 0,
				"min": 0,
				"max": 30,
				"step": 1
			},
			"max-messages": {
				"label": "Max Messages",
				"type": "slider-input",
				"defaultValue": 25,
				"min": 1,
				"max": 200,
				"step": 1,
				"description": "The oldest messages beyond the max will be automatically removed."
			},
			"hide-clipping": {
				"label": "Hide messages that clip out of bounds?",
				"type": "toggle-input",
				"defaultValue": true
			},
			"expire-messages": {
				"label": "Hide messages after some time?",
				"type": "toggle-input",
				"defaultValue": false
			},
			"hide-time": {
				"label": "Hide Time (seconds)",
				"condition": {
					"expire-messages": true
				},
				"type": "number-input",
				"defaultValue": 300,
				"min": 1,
				"step": 1
			}
		}
	},
	"filters-category": {
		"label": "Filters",
		"settings": {
			"user-filters": {
				"label": "User Filters",
				"type": "section",
				"settings": {
					"hide-users": {
						"type": "multi-text-input",
						"defaultValue": [
							"Sery_Bot"
						],
						"placeholder": "Name",
						"label": "Hide Users"
					},
					"follower-only": {
						"type": "toggle-input",
						"defaultValue": false,
						"label": "Follower Only Mode"
					},
					"follow-age": {
						"type": "number-input",
						"defaultValue": 0,
						"min": 0,
						"step": "any",
						"description": "Will only show messages from followers that have followed for at least this many hours.",
						"label": "Minimum follow age (hours)",
						"condition": {
							"follower-only": true
						}
					}
				}
			},
			"message-filters": {
				"label": "Message Filters",
				"type": "section",
				"settings": {
					"hide-prefixes": {
						"type": "multi-text-input",
						"defaultValue": [
							"!"
						],
						"placeholder": "Prefix",
						"label": "Hide messages starting with"
					},
					"hide-words": {
						"type": "multi-text-input",
						"placeholder": "Bad Word",
						"label": "Hide messages containing these words"
					},
					"hide-first-chat": {
						"type": "toggle-input",
						"defaultValue": false,
						"label": "Hide First Time Chat Messages?"
					}
				}
			}
		}
	},
	"sound-category": {
		"label": "Sound Effect",
		"settings": {
			"sound": {
				"label": "Sound",
				"type": "audio-input",
				"description": "Play this sound effect for every chat message."
			},
			"sound-cooldown": {
				"label": "Cooldown (seconds)",
				"type": "slider-input",
				"defaultValue": 5,
				"min": 0,
				"max": 600,
				"step": 1,
				"description": "Minimum time between playing sounds."
			}
		}
	}
}